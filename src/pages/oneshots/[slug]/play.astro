---
// Full-viewport page for one demo: a thin bar and the sandboxed frame.
import '@fontsource-variable/jetbrains-mono/index.css';
import '../../../styles/tokens.css';
import { loadOneshots } from '../../../lib/oneshots/data';
import { DEMO_SANDBOX, EMBED_CSP } from '../../../lib/oneshots/vendor-map';
import type { SyncedRun } from '../../../lib/oneshots/types';

export function getStaticPaths() {
  return loadOneshots().runs.filter((r) => r.demo).map((run) => ({ params: { slug: run.slug }, props: { run } }));
}

interface Props { run: SyncedRun }
const { run } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="Content-Security-Policy" content={EMBED_CSP} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{run.title} · Oneshots · Davis Gee</title>
    <meta name="description" content={run.summary} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={new URL(`/oneshots/${run.slug}/`, Astro.site)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <style>
      html, body { margin: 0; height: 100%; background: var(--paper); color: var(--ink); }
      body { height: 100dvh; display: grid; grid-template-rows: auto minmax(0, 1fr); }
      .bar { display: flex; flex-wrap: wrap; gap: 4px 16px; align-items: baseline; justify-content: space-between; padding: 8px 14px; border-bottom: 1px solid var(--ink); font-family: var(--f-mono); font-size: 12px; }
      .bar a { color: var(--ink); text-decoration: none; padding: 6px 0; margin: -6px 0; }
      /* The run page states the sandbox under its poster; a phone keeps the row for the demo. */
      @media (max-width: 560px) { .bar span { display: none; } }
      .bar a:hover { color: var(--signal); }
      .bar span { color: var(--muted); }
      iframe { display: block; width: 100%; height: 100%; border: 0; background: #fff; }
    </style>
  </head>
  <body>
    <div class="bar"><a href={`/oneshots/${run.slug}/`}>← {run.title}</a><span>Sandboxed: no access to this site, no network</span></div>
    <iframe src={run.demo!.src} sandbox={DEMO_SANDBOX} title={`${run.title}, running`}></iframe>
  </body>
</html>
