---
// One figure plate on Systems: a drawing, its callouts, and a footer with the
// part's language, its first-commit month (from GitHub) and a link.
interface Props { fig: number; name: string; kind: string; meta: string; href: string; linkLabel?: string }
const { fig, name, kind, meta, href, linkLabel = 'Repo →' } = Astro.props;
---
<article class="plate">
  <header><span class="label">Fig. {fig} · {name}</span><span class="label">{kind}</span></header>
  <div class="art"><slot /></div>
  <div class="cap"><slot name="cap" /></div>
  <footer><span>{meta}</span><a href={href}>{linkLabel}</a></footer>
</article>
