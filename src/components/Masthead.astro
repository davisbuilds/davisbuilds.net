---
import { NAV, type NavKey } from '../lib/site';
interface Props { current?: NavKey }
const { current } = Astro.props;
---
<header class="masthead">
  <a class="mark" href="/"><span class="stamp"><svg class="gear" viewBox="0 0 40 40" aria-hidden="true"><path d="M16.78 4.84L17.68 1.14A19 19 0 0 1 22.32 1.14L23.22 4.84A15.5 15.5 0 0 1 28.44 7L31.7 5.03A19 19 0 0 1 34.97 8.3L33 11.56A15.5 15.5 0 0 1 35.16 16.78L38.86 17.68A19 19 0 0 1 38.86 22.32L35.16 23.22A15.5 15.5 0 0 1 33 28.44L34.97 31.7A19 19 0 0 1 31.7 34.97L28.44 33A15.5 15.5 0 0 1 23.22 35.16L22.32 38.86A19 19 0 0 1 17.68 38.86L16.78 35.16A15.5 15.5 0 0 1 11.56 33L8.3 34.97A19 19 0 0 1 5.03 31.7L7 28.44A15.5 15.5 0 0 1 4.84 23.22L1.14 22.32A19 19 0 0 1 1.14 17.68L4.84 16.78A15.5 15.5 0 0 1 7 11.56L5.03 8.3A19 19 0 0 1 8.3 5.03L11.56 7A15.5 15.5 0 0 1 16.78 4.84Z" /></svg><span>DG</span></span><span class="name">Davis Gee</span></a>
  <nav class="nav" aria-label="Site">
    {NAV.map((n) => (
      <a href={n.href} aria-current={current === n.key ? 'page' : undefined}>{n.label}</a>
    ))}
    <button class="kbd" type="button" data-open-palette aria-label="Open command palette">⌘K</button>
  </nav>
</header>
