---
import { NAV, type NavKey } from '../lib/site';
interface Props { current?: NavKey }
const { current } = Astro.props;
---
<header class="masthead">
  <a class="mark" href="/"><span class="stamp"><svg class="gear" viewBox="0 0 40 40" aria-hidden="true"><path d="M16.4 4.41L17.11 1.73A18.5 18.5 0 0 1 22.89 1.73L23.6 4.41A16 16 0 0 1 28.48 6.43L30.87 5.03A18.5 18.5 0 0 1 34.97 9.13L33.57 11.52A16 16 0 0 1 35.59 16.4L38.27 17.11A18.5 18.5 0 0 1 38.27 22.89L35.59 23.6A16 16 0 0 1 33.57 28.48L34.97 30.87A18.5 18.5 0 0 1 30.87 34.97L28.48 33.57A16 16 0 0 1 23.6 35.59L22.89 38.27A18.5 18.5 0 0 1 17.11 38.27L16.4 35.59A16 16 0 0 1 11.52 33.57L9.13 34.97A18.5 18.5 0 0 1 5.03 30.87L6.43 28.48A16 16 0 0 1 4.41 23.6L1.73 22.89A18.5 18.5 0 0 1 1.73 17.11L4.41 16.4A16 16 0 0 1 6.43 11.52L5.03 9.13A18.5 18.5 0 0 1 9.13 5.03L11.52 6.43A16 16 0 0 1 16.4 4.41Z" /></svg><span>DG</span></span><span class="name">Davis Gee</span></a>
  <nav class="nav" aria-label="Site">
    {NAV.map((n) => (
      <a href={n.href} aria-current={current === n.key ? 'page' : undefined}>{n.label}</a>
    ))}
    <button class="kbd" type="button" data-open-palette aria-label="Open command palette">⌘K</button>
  </nav>
</header>
