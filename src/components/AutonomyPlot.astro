---
// Wall clock (log scale) against human turns, for runs that recorded both.
// Drawn at build time; src/scripts/plot.ts adds the tooltip.
import { duration, placeLabels, plotPoints } from '../lib/oneshots/stats';
import type { SyncedRun } from '../lib/oneshots/types';

interface Props { runs: SyncedRun[] }
const points = plotPoints(Astro.props.runs);
const W = 760, H = 260, L = 48, R = 20, T = 16, B = 34, pw = W - L - R, ph = H - T - B;
const maxMin = Math.max(1200, ...points.map((p) => p.minutes));
const minMin = Math.min(30, ...points.map((p) => p.minutes));
const maxTurns = Math.max(4, ...points.map((p) => p.turns));
const lx = (m: number) => L + ((Math.log(m) - Math.log(minMin)) / (Math.log(maxMin) - Math.log(minMin))) * pw;
const ly = (t: number) => T + ph - (t / maxTurns) * ph;
const xTicks = [[30, '30m'], [60, '1h'], [120, '2h'], [240, '4h'], [480, '8h'], [960, '16h']].filter(([m]) => (m as number) >= minMin && (m as number) <= maxMin) as [number, string][];
const yTicks = Array.from({ length: maxTurns + 1 }, (_, i) => i);
const detail = (p: (typeof points)[number]) => `${p.model} · ${duration(p.minutes)} · ${p.turns} human turn${p.turns === 1 ? '' : 's'}`;
const short = (p: (typeof points)[number]) => p.title.split(' — ')[0];
const labels = placeLabels(points.map((p) => ({ x: lx(p.minutes), y: ly(p.turns), text: short(p) })), { left: L, right: W - 4, top: 0, bottom: T + ph });
const summary = points.length
  ? `Scatter plot of ${points.length} runs by wall-clock time and human turns: ${points.map((p) => `${p.title}, ${duration(p.minutes)}, ${p.turns}`).join('; ')}.`
  : 'No run has recorded both wall-clock time and human turns yet.';
---
<div class="chart-wrap" style="margin-top:0">
  <div class="chart-cap"><span class="label">X: wall-clock time, log scale · Y: human turns, brief included</span>{points.length === 0 && <span class="label">No runs to plot yet</span>}</div>
  <svg class="plot" id="plot" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={summary}>
    {yTicks.map((t) => <><line x1={L} x2={W - R} y1={ly(t)} y2={ly(t)} stroke="var(--rule)" stroke-dasharray={t ? '2 3' : undefined} /><text x={L - 8} y={ly(t) + 3.5} text-anchor="end" class="ax">{t}</text></>)}
    {xTicks.map(([m, lab]) => <><line x1={lx(m)} x2={lx(m)} y1={T} y2={T + ph} stroke="var(--rule)" stroke-dasharray="2 3" /><text x={lx(m)} y={H - 12} text-anchor="middle" class="ax">{lab}</text></>)}
    {points.map((p, i) => {
      const x = lx(p.minutes).toFixed(1), y = ly(p.turns).toFixed(1), l = labels[i];
      return <g class="pt" data-title={p.title} data-detail={detail(p)}><circle class="hit" cx={x} cy={y} r="14" /><circle class="dot" cx={x} cy={y} r="5" />{l && <text x={l.x.toFixed(1)} y={l.y.toFixed(1)} text-anchor={l.anchor} class="lab">{short(p)}</text>}</g>;
    })}
  </svg>
  <div class="plot-tip" id="plot-tip" hidden><b></b><span></span></div>
</div>
<script>
  import '../scripts/plot';
</script>
